# Root gitignore to handle both client and server

# Dependency directories
node_modules/
client/node_modules/
server/node_modules/

# Build outputs
client/dist/
client/dist-ssr/
server/dist/

# Environment variables
.env
client/.env
client/.env.local
client/.env.production.local
server/.env
server/.env.local

# IDE and OS files
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Other
coverage/
.nyc_output/
.eslintcache
.pnp.*
.yarn/
